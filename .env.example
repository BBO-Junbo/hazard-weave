# Provider selection: auto | mock | blob | external | postgres
# auto priority: DATABASE_URL -> EXTERNAL_DATA_API_URL -> BLOB_READ_WRITE_TOKEN -> mock
DATA_PROVIDER=auto

# Protects POST /api/admin/seed. Use a long random value in Vercel.
ADMIN_API_KEY=replace-with-a-long-random-secret

# ---------- Vercel Blob provider ----------
# Added automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=
BLOB_DATA_PATHNAME=hazardweave/dashboard-data.json
BLOB_ACCESS=private

# ---------- External REST provider ----------
# Expected GET response: DashboardPayload JSON (see shared/contracts.ts).
EXTERNAL_DATA_API_URL=
EXTERNAL_DATA_API_DASHBOARD_PATH=dashboard
EXTERNAL_DATA_API_TOKEN=
EXTERNAL_DATA_API_WRITE_ENABLED=false

# ---------- Connected Postgres provider ----------
# May point to Neon, Supabase or another Vercel Marketplace integration.
DATABASE_URL=
POSTGRES_DATASET_KEY=default

# ---------- Public frontend configuration ----------
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_ALLOW_MOCK_FALLBACK=true

# Optional imagery service overrides
VITE_TDOT_IMAGERY_TILE_URL=https://tnmap.tn.gov/arcgis/services/BASEMAPS/IMAGERY_WEB_MERCATOR/MapServer/WMSServer?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&LAYERS=0&STYLES=&FORMAT=image/png&TRANSPARENT=TRUE&SRS=EPSG:3857&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256
VITE_NAIP_TILE_URL=https://gis.apfo.usda.gov/arcgis/rest/services/NAIP/USDA_CONUS_PRIME/ImageServer/tile/{z}/{y}/{x}

# Live flood-source behavior. Vercel deployment uses /api/flood/* first.
# With plain `npm run dev`, the browser can attempt official public endpoints
# directly if the Vercel Functions are not running.
VITE_ALLOW_DIRECT_FLOOD_FALLBACK=true

# Public community-data behavior. Under plain `npm run dev`, the browser
# can use CDC/ATSDR, OpenFEMA and public Overpass mirrors directly. Set true
# when running `vercel dev` so requests use same-origin Vercel Functions.
VITE_ALLOW_DIRECT_PUBLIC_DATA_FALLBACK=true
# VITE_USE_VERCEL_PROXY=true

# ---------- AI model router ----------
# false enables live /api/chat calls. Keep true only for UI-only demos.
VITE_AI_FRONTEND_PREVIEW=false

# HazardWeave Lite: server-to-server OpenAI-compatible endpoint.
# This may be plain HTTP with a public IP because Vercel calls it server-side.
# Example: http://203.0.113.20:8000/v1
HAZARDWEAVE_LLM_URL=
HAZARDWEAVE_LLM_MODEL=hazardweave-lite
# Optional shared secret forwarded as an API key/Bearer credential to your gateway.
HAZARDWEAVE_LLM_TOKEN=
